# Where models, caches, inputs, outputs and job files live (needs ~40 GB free)
ASSETS_DIR=/path/to/subarashii-assets
UID=1000
GID=1000
WEB_PORT=7860

# Translator: llamacpp (local, default) | openai (any OpenAI-compatible server) | anthropic
LLM_PROVIDER=llamacpp
LLAMACPP_URL=http://host.docker.internal:11434
LLAMACPP_API_KEY=
LLAMACPP_MODEL=qwen3-30b-a3b

OPENAI_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
